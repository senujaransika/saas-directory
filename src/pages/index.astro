---
import data from '../data/data.json';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>B2B SaaS Compliance Directory</title>
  </head>
  <body class="bg-slate-50 min-h-screen font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      
      <!-- Header Section -->
      <header class="mb-14 text-center">
        <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
          Software Compliance Integrations
        </h1>
        <p class="text-lg text-slate-500 max-w-2xl mx-auto">
          Discover secure B2B software pairings for HIPAA, SOC-2, and PCI-DSS compliance.
        </p>
      </header>

      <!-- Grid Cards Section -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {data.map((item) => (
          <a href={`/${item.slug}`} class="bg-white rounded-xl shadow-sm hover:shadow-xl border border-slate-200 transition-all duration-300 p-6 flex flex-col group">
            <h2 class="text-xl font-bold text-slate-800 mb-2 group-hover:text-blue-600 transition-colors">
              {item.title}
            </h2>
            <p class="text-slate-500 text-sm mb-5 line-clamp-3">
              {item.description}
            </p>
            <!-- Card Footer / Link -->
            <div class="mt-auto pt-4 border-t border-slate-100 text-blue-600 text-sm font-semibold flex items-center">
              View Details <span class="ml-1 group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </body>
</html>