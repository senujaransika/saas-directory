---
import data from '../data/data.json';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>B2B SaaS Compliance Directory</title>
  </head>
  <body class="bg-slate-50 min-h-screen font-sans">
    
    <!-- Hero Section -->
    <div class="relative bg-white border-b border-slate-200 overflow-hidden">
      <!-- Background Grid & Glow -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"></div>
      <div class="absolute left-0 right-0 top-0 -z-10 m-auto h-[310px] w-[310px] rounded-full bg-blue-400 opacity-20 blur-[100px]"></div>
      
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-24 text-center">
        <span class="inline-block py-1 px-3 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-sm font-bold mb-6">
          ✨ The Ultimate Integration Directory
        </span>
        <h1 class="text-5xl md:text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-slate-900 to-blue-700 tracking-tight mb-6">
          Secure Software Integrations
        </h1>
        <p class="text-xl text-slate-500 max-w-2xl mx-auto mb-10">
          Discover trusted B2B software pairings for HIPAA, SOC-2, and PCI-DSS compliance.
        </p>
        
        <!-- Search Bar -->
        <div class="max-w-2xl mx-auto relative group">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <svg class="h-6 w-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input type="text" id="searchInput" class="block w-full pl-12 pr-4 py-4 rounded-2xl border border-slate-200 bg-white text-lg shadow-sm focus:ring-4 focus:ring-blue-50 focus:border-blue-500 outline-none" placeholder="Search for HubSpot, Stripe, HIPAA, etc..." />
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      
      <!-- No Results Message -->
      <div id="noResults" class="hidden text-center py-10">
        <h3 class="text-2xl font-bold text-slate-700 mb-2">No integrations found</h3>
        <p class="text-slate-500">Try adjusting your search terms.</p>
      </div>

      <!-- Grid Cards -->
      <div id="cardsContainer" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {data.map((item) => (
          <a href={`/${item.slug}`} 
             class="integration-card bg-white rounded-2xl shadow-sm hover:shadow-2xl hover:-translate-y-1 border border-slate-100 hover:border-blue-300 transition-all duration-300 p-7 flex flex-col group"
             data-search={item.h1_title + " " + item.primary_software + " " + item.integration_partner + " " + item.compliance_type}
          >
            <!-- Badges -->
            <div class="flex items-center gap-3 mb-4">
              <span class="px-3 py-1 bg-blue-50 text-blue-700 text-xs font-bold rounded-full">
                {item.compliance_type}
              </span>
              <span class="px-3 py-1 bg-slate-100 text-slate-600 text-xs font-semibold rounded-full">
                Difficulty: {item.setup_difficulty}
              </span>
            </div>

            <!-- Title & Description -->
            <h2 class="text-xl font-extrabold text-slate-800 mb-3 group-hover:text-blue-600 transition-colors line-clamp-2">
              {item.h1_title}
            </h2>
            <p class="text-slate-500 text-sm mb-6 line-clamp-3">
              {item.meta_description}
            </p>
            
            <!-- Footer -->
            <div class="mt-auto pt-5 border-t border-slate-100 flex items-center justify-between">
              <span class="text-blue-600 text-sm font-bold flex items-center">
                View Setup →
              </span>
              <span class="text-slate-600 text-sm font-medium">
                {item.monthly_cost}
              </span>
            </div>
          </a>
        ))}
      </div>
      
      <!-- Footer -->
      <footer class="mt-24 pt-8 border-t border-slate-200 text-center text-sm text-slate-500">
        <div class="flex justify-center gap-6 mb-4">
          <a href="/about" class="hover:text-blue-600 transition-colors">About Us</a>
          <a href="/contact" class="hover:text-blue-600 transition-colors">Contact</a>
          <a href="/privacy" class="hover:text-blue-600 transition-colors">Privacy Policy</a>
        </div>
        <p>© 2026 B2B SaaS Compliance Directory. All rights reserved.</p>
      </footer>
    </div>

    <!-- Search Script -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        var searchInput = document.getElementById('searchInput');
        var cards = document.querySelectorAll('.integration-card');
        var noResults = document.getElementById('noResults');

        if (searchInput) {
          searchInput.addEventListener('input', function(e) {
            var searchTerm = e.target.value.toLowerCase();
            var visibleCount = 0;

            cards.forEach(function(card) {
              var searchData = card.getAttribute('data-search');
              if (searchData && searchData.toLowerCase().includes(searchTerm)) {
                card.style.display = 'flex';
                visibleCount++;
              } else {
                card.style.display = 'none';
              }
            });

            if (noResults) {
              noResults.style.display = visibleCount === 0 ? 'block' : 'none';
            }
          });
        }
      });
    </script>
  </body>
</html>