---
import data from '../data/data.json';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>B2B SaaS Compliance Directory</title>
  </head>
  <body class="bg-slate-50 min-h-screen font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      
      <!-- Header Section -->
      <header class="mb-14 text-center">
        <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
          Software Compliance Integrations
        </h1>
        <p class="text-lg text-slate-500 max-w-2xl mx-auto">
          Discover secure B2B software pairings for HIPAA, SOC-2, and PCI-DSS compliance.
        </p>
      </header>

      <!-- Grid Cards Section -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {data.map((item) => (
          <a href={`/${item.slug}`} class="bg-white rounded-xl shadow-sm hover:shadow-xl border border-slate-200 transition-all duration-300 p-6 flex flex-col group">
            
            <!-- Badges -->
            <div class="flex items-center gap-2 mb-3">
              <span class="px-2.5 py-0.5 bg-blue-50 text-blue-700 text-xs font-semibold rounded-full border border-blue-100">
                {item.compliance_type}
              </span>
              <span class="px-2.5 py-0.5 bg-slate-100 text-slate-600 text-xs font-medium rounded-full border border-slate-200">
                Difficulty: {item.setup_difficulty}
              </span>
            </div>

            <!-- Title & Description -->
            <h2 class="text-xl font-bold text-slate-800 mb-2 group-hover:text-blue-600 transition-colors line-clamp-2">
              {item.h1_title}
            </h2>
            
            <p class="text-slate-500 text-sm mb-5 line-clamp-3">
              {item.meta_description}
            </p>
            
            <!-- Card Footer / Link -->
            <div class="mt-auto pt-4 border-t border-slate-100 text-blue-600 text-sm font-semibold flex items-center justify-between">
              <span>View Details <span class="ml-1 group-hover:translate-x-1 inline-block transition-transform">→</span></span>
              <span class="text-slate-400 font-normal">{item.monthly_cost}</span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </body>
</html>