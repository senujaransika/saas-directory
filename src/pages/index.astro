---
import data from '../data/data.json';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>B2B SaaS Compliance Directory</title>
  </head>
  <body class="bg-slate-50 min-h-screen font-sans">
    
    <!-- Hero Section with Graphical Background -->
    <div class="relative bg-white border-b border-slate-200 overflow-hidden">
      <!-- Background Grid & Glow Effect -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"></div>
      <div class="absolute left-0 right-0 top-0 -z-10 m-auto h-[310px] w-[310px] rounded-full bg-blue-400 opacity-20 blur-[100px]"></div>
      
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-24 text-center">
        <span class="inline-block py-1 px-3 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-sm font-bold mb-6">
          ✨ The Ultimate Integration Directory
        </span>
        <h1 class="text-5xl md:text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-slate-900 to-blue-700 tracking-tight mb-6">
          Secure Software Integrations
        </h1>
        <p class="text-xl text-slate-500 max-w-2xl mx-auto mb-10">
          Discover trusted B2B software pairings for HIPAA, SOC-2, and PCI-DSS compliance. Build your tech stack without compromising security.
        </p>
        
        <!-- Graphical Search Bar -->
        <div class="max-w-2xl mx-auto relative group">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <!-- Search Icon -->
            <svg class="h-6 w-6 text-slate-400 group-focus-within:text-blue-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input type="text" class="block w-full pl-12 pr-4 py-4 rounded-2xl border border-slate-200 bg-white text-lg shadow-sm focus:ring-4 focus:ring-blue-50 focus:border-blue-500 transition-all outline-none" placeholder="Search for HubSpot, Stripe, Salesforce..." />
          <button class="absolute inset-y-2 right-2 bg-blue-600 hover:bg-blue-700 text-white px-6 rounded-xl font-medium transition-colors shadow-sm">
            Search
          </button>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <!-- Grid Cards Section -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {data.map((item) => (
          <a href={`/${item.slug}`} class="bg-white rounded-2xl shadow-sm hover:shadow-2xl hover:-translate-y-1 border border-slate-100 hover:border-blue-300 transition-all duration-300 p-7 flex flex-col group relative overflow-hidden">
            
            <!-- Graphical Badge row with Icons -->
            <div class="flex items-center gap-3 mb-4">
              <!-- Compliance Badge with Shield Icon -->
              <span class="flex items-center gap-1.5 px-3 py-1 bg-blue-50 text-blue-700 text-xs font-bold rounded-full border border-blue-100">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM6.53 9.53a.75.75 0 011.06 0L9 10.939l2.47-2.47a.75.75 0 111.06 1.06l-3 3a.75.75 0 01-1.06 0l-2-2a.75.75 0 010-1.06z" clip-rule="evenodd" />
                </svg>
                {item.compliance_type}
              </span>
              
              <!-- Difficulty Badge with Chart Icon -->
              <span class="flex items-center gap-1.5 px-3 py-1 bg-slate-100 text-slate-600 text-xs font-semibold rounded-full border border-slate-200">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
                {item.setup_difficulty}
              </span>
            </div>

            <!-- Title & Description -->
            <h2 class="text-xl font-extrabold text-slate-800 mb-3 group-hover:text-blue-600 transition-colors leading-snug line-clamp-2">
              {item.h1_title}
            </h2>
            
            <p class="text-slate-500 text-sm mb-6 line-clamp-3 leading-relaxed">
              {item.meta_description}
            </p>
            
            <!-- Card Footer / Link with Icons -->
            <div class="mt-auto pt-5 border-t border-slate-100 flex items-center justify-between">
              <span class="text-blue-600 text-sm font-bold flex items-center group-hover:translate-x-1 transition-transform">
                View Setup 
                <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </span>
              <!-- Cost Badge with Dollar Icon -->
              <span class="flex items-center gap-1 text-slate-600 text-sm font-medium bg-slate-50 px-2 py-1 rounded-md">
                <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {item.monthly_cost}
              </span>
            </div>
            
          </a>
        ))}
      </div>
      
      <!-- Footer Section -->
      <footer class="mt-24 pt-8 border-t border-slate-200 text-center text-sm text-slate-500">
        <div class="flex justify-center gap-6 mb-4">
          <a href="/about" class="hover:text-blue-600 transition-colors">About Us</a>
          <a href="/contact" class="hover:text-blue-600 transition-colors">Contact</a>
          <a href="/privacy" class="hover:text-blue-600 transition-colors">Privacy Policy</a>
        </div>
        <p>© 2026 B2B SaaS Compliance Directory. All rights reserved.</p>
      </footer>
    </div>
  </body>
</html>