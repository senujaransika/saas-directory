---
import data from '../data/data.json';

export function getStaticPaths() {
  return data.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{entry.title} - Setup Instructions</title>
  </head>
  <body class="bg-slate-50 min-h-screen font-sans">
    <div class="max-w-3xl mx-auto px-4 py-12">
      
      <!-- Back Button -->
      <a href="/" class="inline-flex items-center text-slate-500 hover:text-blue-600 mb-8 transition-colors font-medium">
        ← Back to Directory
      </a>

      <!-- Main Content Box -->
      <article class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 md:p-12">
        <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-6 tracking-tight">
          {entry.title}
        </h1>
        
        <div class="mb-8">
          <p class="text-lg text-slate-600 leading-relaxed">
            {entry.description}
          </p>
        </div>

        <!-- Call to Action Button (Affiliate Link) -->
        <a 
          href={entry.affiliate_link || "#"} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="block w-full text-center bg-blue-600 hover:bg-blue-700 text-white text-lg font-bold py-4 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200"
        >
          View Setup Instructions 🚀
        </a>
      </article>

    </div>
  </body>
</html>